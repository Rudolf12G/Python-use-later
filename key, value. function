# tells Python to loop through each key-value pair in the dictionary
# the first column is mark as "name", else "language"
favorite_languages = {
    'jen': 'python',
    'sarah': 'c',
    'edward': 'ruby',
    'phil': 'python',
}

'''
use this if you want to print the key, {'1':'...'}
print(key)

and this if you want to print the value, {'...':'rudolf'}
'''

for name, language in favorite_languages.items():
    print(f"{name.title()}'s favorite language is {language.title()}.")

# Both print the Key and Main Value
for key, value in sorted(favorite_languages.items()):
print(f"{key} {value}")
