# tells Python to loop through each key-value pair in the dictionary
# the first column is mark as "name", else "language"
favorite_languages = {
    'jen': 'python',
    'sarah': 'c',
    'edward': 'ruby',
    'phil': 'python',
}

'''
loop statement that work like this (key, value)
'''
     for names, language in favorite_languages():
        print(f"The {names} Loves {language}")
